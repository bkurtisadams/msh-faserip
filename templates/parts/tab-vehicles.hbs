        <div class="tab" data-tab="vehicles">
          <table class="vehicles-table">
            <thead>
              <tr>
                <th class="roll-col"></th>
                <th class="name-col">Name<span class="th-inline-actions"><a class="th-action-link add-vehicle" title="Add Vehicle">+ add</a><a class="th-action-link browse-compendium" data-type="vehicles" title="Browse Vehicles Compendium">browse</a></span></th>
                <th class="type-col">Type</th>
                <th class="cost-col">Cost</th>
                <th class="control-col">Ctrl</th>
                <th class="speed-col">Spd</th>
                <th class="body-col">Bod</th>
                <th class="protection-col">Prot</th>
                <th class="th-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each vehicles as |item i|}}
              <tr class="vehicle-row item" data-item-id="{{item._id}}" draggable="true" title="Shift+drag to reorder.">
                <td class="roll-col">
                  <a class="vehicle-control-roll" data-item-id="{{item._id}}" title="Roll Control FEAT">
                    <i class="fas fa-dice-d20"></i>
                  </a>
                </td>
                <td class="vehicle-name">
                  <div class="vehicle-icon vehicle-info" data-item-id="{{item._id}}">
                    <img src="{{item.img}}" width="24" height="24" />
                  </div>
                  <span class="vehicle-name-text vehicle-draggable" data-item-id="{{item._id}}" draggable="true">
                    {{item.name}}
                  </span>
                </td>
                
                <td>{{item.system.type}}</td>
                <td title="{{item.system.cost}}">{{abbreviateRank item.system.cost}}</td>
                <td title="{{item.system.control}}">{{abbreviateRank item.system.control}}</td>
                <td title="{{item.system.speed}}">{{abbreviateRank item.system.speed}}</td>
                <td title="{{item.system.body}}">{{abbreviateRank item.system.body}}</td>
                <td title="{{item.system.protection}}">{{abbreviateRank item.system.protection}}</td>
                <td class="vehicle-actions">
                  <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
                  <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>

          {{#unless vehicles.length}}
          <p class="no-vehicles">No vehicles added yet.</p>
          {{/unless}}
        </div>
