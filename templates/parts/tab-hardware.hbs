{{!-- tab-hardware.hbs — v1.2.0: Slice 3 — invention/modification mode toggle with modification panel (one-rank-at-a-time boosts, easy/hard capability adds), kit-bash button with live Karma cost on design/building projects, salvage action on testing/failed devices, salvaged badge, Repair Device and Tech FEATs utility links in the tab header. --}}
{{!-- v1.1.0: Slice 2 — pipeline (Resource FEAT, build tracker, success FEAT, testing links). v1.0.0: Slice 1 — shell + effective-cost calculator. --}}
<div class="tab" data-tab="hardware">
  <div class="tab-list-header labeled">
    <span class="th-label">Hardware</span>
    <div class="th-actions">
      <a class="th-action-link hw-repair-tool" title="Repair-center and field repairs">repair</a>
      <a class="th-action-link hw-tech-feats" title="Alien tech, borrowed devices, computers">tech FEATs</a>
      <a class="th-action-link hw-add-invention" title="Start a new invention or modification">+ new invention</a>
    </div>
  </div>

  <div class="hw-inventor-strip">
    <span class="hw-inv-stat"><label>Reason</label> {{hwInventor.reasonRank}} ({{hwInventor.reasonValue}})</span>
    <span class="hw-inv-stat"><label>Resources</label> {{hwInventor.resourcesRank}} ({{hwInventor.resourcesValue}})</span>
    <span class="hw-inv-note">A hero may attempt a device whose effective cost exceeds his Reason — the success roll reads one color worse.</span>
  </div>

  {{#if hardwareProjects.length}}
  {{#each hardwareProjects as |p|}}
  <div class="hw-project hw-status-{{p.system.hardware.status}}" data-item-id="{{p._id}}">
    <div class="hw-project-header">
      <img src="{{p.img}}" class="hw-icon" width="24" height="24" />
      <input type="text" class="hw-name" value="{{p.name}}" placeholder="Invention name" />
      {{#if (eq p.system.hardware.mode "modification")}}<span class="hw-badge hw-badge-mod" title="Modification of an existing device">MOD</span>{{/if}}
      {{#if p.system.hardware.salvaged}}<span class="hw-badge hw-badge-salvage" title="Built on salvaged materials — +1CS on the success roll">SALVAGE</span>{{/if}}
      <select class="hw-field hw-status" data-hw-path="status">
        <option value="design"   {{#if (eq p.system.hardware.status "design")}}selected{{/if}}>Design</option>
        <option value="building" {{#if (eq p.system.hardware.status "building")}}selected{{/if}}>Building</option>
        <option value="testing"  {{#if (eq p.system.hardware.status "testing")}}selected{{/if}}>Testing</option>
        <option value="complete" {{#if (eq p.system.hardware.status "complete")}}selected{{/if}}>Complete</option>
        <option value="failed"   {{#if (eq p.system.hardware.status "failed")}}selected{{/if}}>Failed</option>
      </select>
      <span class="hw-badge hw-badge-cost" title="Effective Cost">{{p.hw.cost}}</span>
      <span class="hw-badge hw-badge-days" title="Build time (adjusted / base)">{{p.hw.adjDays}}d / {{p.hw.days}}d</span>
      <span class="hw-header-actions">
        <a class="hw-open" title="Open item sheet"><i class="fas fa-edit"></i></a>
        <a class="hw-delete" title="Delete invention"><i class="fas fa-trash"></i></a>
      </span>
    </div>

    {{#if (eq p.system.hardware.status "design")}}
    <div class="hw-pipeline">
      <a class="hw-btn hw-roll-resources" title="Resource FEAT vs effective cost — failure locks attempts for one week"><i class="fas fa-coins"></i> Resource FEAT vs {{p.hw.cost}}</a>
      <a class="hw-btn hw-btn-kitbash hw-kitbash" title="Kit-bash from parts at hand: {{p.hw.kitRounds}} rounds, {{p.hw.kitKarma}} Karma"><i class="fas fa-bolt"></i> Kit-bash ({{p.hw.kitKarma}} Karma)</a>
      <span class="hw-pipe-note">Fund the project to begin construction — or kit-bash it when Terminus pops up.</span>
    </div>
    {{/if}}

    {{#if (eq p.system.hardware.status "building")}}
    <div class="hw-pipeline">
      <span class="hw-funded" title="Funded {{p.system.hardware.resourceFeat.gameDate}}"><i class="fas fa-check"></i> Funded</span>
      <div class="hw-progress" title="{{p.system.hardware.time.daysElapsed}} of {{p.hw.adjDays}} adjusted days">
        <div class="hw-progress-fill" style="width:{{p.hw.progressPct}}%;"></div>
        <span class="hw-progress-label">{{p.system.hardware.time.daysElapsed}} / {{p.hw.adjDays}}d</span>
      </div>
      <a class="hw-btn hw-day-add" data-days="1" title="Log one day of work">+1d</a>
      <a class="hw-btn hw-day-add" data-days="5" title="Log five days of work">+5d</a>
      <a class="hw-btn hw-day-complete" title="Log remaining build time"><i class="fas fa-forward"></i></a>
      <a class="hw-btn hw-btn-kitbash hw-kitbash" title="Rush the remaining {{p.hw.remainingDays}} days in {{p.hw.kitRounds}} rounds for {{p.hw.kitKarma}} Karma"><i class="fas fa-bolt"></i> Kit-bash ({{p.hw.kitKarma}})</a>
      <a class="hw-btn hw-roll-success {{#unless p.hw.timeDone}}hw-btn-disabled{{/unless}}" title="Reason FEAT — does the invention work?"><i class="fas fa-flask"></i> Success FEAT</a>
    </div>
    {{/if}}

    {{#if (eq p.system.hardware.status "testing")}}
    <div class="hw-pipeline">
      {{#if (eq p.system.hardware.successFeat.color "yellow")}}
      <span class="hw-pipe-note"><b>Working prototype</b> — operates at -1CS until fine-tuned ({{p.system.hardware.successFeat.fineTuneDays}} more days).</span>
      <a class="hw-btn hw-finish-tuning"><i class="fas fa-check"></i> Fine-tuning complete</a>
      {{/if}}
      {{#if (eq p.system.hardware.successFeat.color "green")}}
      <span class="hw-pipe-note">{{#if p.system.hardware.kitBashed}}<b>Kit-bashed</b> — operates {{p.system.hardware.successFeat.failTurns}} rounds, then becomes inoperative (possibly spectacularly).{{else}}<b>It flies, Wilbur…</b> — device fails after {{p.system.hardware.successFeat.failTurns}} turns. Repair = rebuild (same time, +1 special requirement, no new Resource FEAT).{{/if}}</span>
      {{#unless p.system.hardware.kitBashed}}<a class="hw-btn hw-restart"><i class="fas fa-rotate-left"></i> Rebuild</a>{{/unless}}
      <a class="hw-btn hw-salvage" title="Salvage the pieces — +1CS on future rolls to duplicate the device"><i class="fas fa-recycle"></i> Salvage</a>
      <a class="hw-btn hw-finish-tuning" title="GM: device held together"><i class="fas fa-check"></i> Mark complete</a>
      {{/if}}
    </div>
    {{/if}}

    {{#if (eq p.system.hardware.status "failed")}}
    <div class="hw-pipeline">
      <span class="hw-pipe-note">The device does not work as built.</span>
      <a class="hw-btn hw-salvage" title="Salvage the pieces — +1CS on future rolls to duplicate the device"><i class="fas fa-recycle"></i> Salvage</a>
    </div>
    {{/if}}

    {{#if (eq p.system.hardware.status "complete")}}
    <div class="hw-pipeline hw-pipeline-done">
      <span class="hw-funded"><i class="fas fa-check-double"></i> Complete{{#if p.system.hardware.successFeat.gameDate}} — {{p.system.hardware.successFeat.gameDate}}{{/if}}</span>
      <span class="hw-pipe-note">The device is a normal equipment item on the Equipment tab.{{#if p.system.hardware.kitBashed}} <b>Kit-bashed:</b> salvage grants +1CS to rebuild it properly.{{/if}}</span>
    </div>
    {{/if}}

    <details class="hw-project-body">
      <summary>Effective-cost calculator</summary>

      <div class="hw-row">
        <label>Project type</label>
        <select class="hw-field" data-hw-path="mode">
          <option value="invention"    {{#if (eq p.system.hardware.mode "invention")}}selected{{/if}}>Invention (new device)</option>
          <option value="modification" {{#if (eq p.system.hardware.mode "modification")}}selected{{/if}}>Modification (existing device)</option>
        </select>
      </div>

      {{#if (eq p.system.hardware.mode "modification")}}
      <div class="hw-mod-panel">
        <div class="hw-row">
          <label>Target device</label>
          <input type="text" class="hw-field hw-mod-target" data-hw-path="mod.target" value="{{p.system.hardware.mod.target}}" placeholder="e.g. the convertible, Web-Shooters" />
        </div>
        <div class="hw-row">
          <label>Kind</label>
          <select class="hw-field" data-hw-path="mod.kind">
            <option value="abilityBoost"      {{#if (eq p.system.hardware.mod.kind "abilityBoost")}}selected{{/if}}>Improve a rank (one rank at a time)</option>
            <option value="addCapabilityEasy" {{#if (eq p.system.hardware.mod.kind "addCapabilityEasy")}}selected{{/if}}>Add capability — simple installation</option>
            <option value="addCapabilityHard" {{#if (eq p.system.hardware.mod.kind "addCapabilityHard")}}selected{{/if}}>Add capability — device must be altered</option>
          </select>
        </div>
        {{#if (eq p.system.hardware.mod.kind "abilityBoost")}}
        <div class="hw-row">
          <label>From rank</label>
          <select class="hw-mod-from">
            {{> "systems/msh-faserip/templates/parts/rank-options.hbs" ranks=@root.hwRankChoices selected=p.system.hardware.mod.fromRank}}
          </select>
          <span class="hw-class-hint">→ {{p.system.hardware.mod.toRank}} (one rank; further improvements are separate modifications)</span>
        </div>
        {{/if}}
        {{#if (eq p.system.hardware.mod.kind "addCapabilityHard")}}
        <div class="hw-row">
          <label>New power rank</label>
          <select class="hw-field" data-hw-path="mod.newPowerRank">
            {{> "systems/msh-faserip/templates/parts/rank-options.hbs" ranks=@root.hwRankChoices selected=p.system.hardware.mod.newPowerRank}}
          </select>
          <span class="hw-class-hint">Good floor; Monstrous floor if beyond 1980s tech.</span>
        </div>
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.beyondTech" {{#if p.system.hardware.modifiers.beyondTech}}checked{{/if}} /> Not reproducible by 1980s tech (Monstrous minimum)</label>
        {{/if}}
        <span class="hw-pipe-note">One modification at a time. Failure may damage the original device.</span>
      </div>
      {{else}}

      <div class="hw-row">
        <label>Item class</label>
        <select class="hw-field" data-hw-path="itemClass">
          <option value="weapon"    {{#if (eq p.system.hardware.itemClass "weapon")}}selected{{/if}}>Weapon</option>
          <option value="vehicle"   {{#if (eq p.system.hardware.itemClass "vehicle")}}selected{{/if}}>Vehicle</option>
          <option value="powersuit" {{#if (eq p.system.hardware.itemClass "powersuit")}}selected{{/if}}>Power Suit</option>
          <option value="robot"     {{#if (eq p.system.hardware.itemClass "robot")}}selected{{/if}}>Robot / Construct</option>
          <option value="other"     {{#if (eq p.system.hardware.itemClass "other")}}selected{{/if}}>Other Device</option>
        </select>
        <span class="hw-class-hint">
          {{#if (eq p.system.hardware.itemClass "weapon")}}Applicable ranks: Damage (or Intensity), Range, Material Strength. Thrown weapons ignore the Range rank.{{/if}}
          {{#if (eq p.system.hardware.itemClass "vehicle")}}Applicable ranks: Control, Speed, Body, Protection.{{/if}}
          {{#if (eq p.system.hardware.itemClass "powersuit")}}Applicable ranks: modified abilities, plus Material Strength or Body Armor (whichever is higher). Shift-style suits: use +1CS custom per ability shift instead of set ranks.{{/if}}
          {{#if (eq p.system.hardware.itemClass "robot")}}Applicable ranks: all listed abilities and Power ranks. Omit abilities the robot lacks.{{/if}}
          {{#if (eq p.system.hardware.itemClass "other")}}Applicable ranks: Material Strength and any Power ranks involved.{{/if}}
        </span>
      </div>

      <div class="hw-ranks">
        <div class="hw-ranks-head">
          <label>Applicable ranks</label>
          <a class="hw-rank-add" title="Add applicable rank">+ add rank</a>
        </div>
        {{#each p.system.hardware.applicableRanks as |r idx|}}
        <div class="hw-rank-row" data-idx="{{idx}}">
          <input type="text" class="hw-rank-label" value="{{r.label}}" placeholder="e.g. Damage, Speed, Material Strength" />
          <select class="hw-rank-rank">
            {{> "systems/msh-faserip/templates/parts/rank-options.hbs" ranks=@root.hwRankChoices selected=r.rank}}
          </select>
          <a class="hw-rank-remove" title="Remove"><i class="fas fa-times"></i></a>
        </div>
        {{/each}}
      </div>

      <div class="hw-mods">
        <label class="hw-mods-title">Cost modifiers</label>
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.beyondTech" {{#if p.system.hardware.modifiers.beyondTech}}checked{{/if}} /> Not reproducible by 1980s tech (adds Monstrous applicable rank)</label>
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.invisible" {{#if p.system.hardware.modifiers.invisible}}checked{{/if}} /> Cannot normally be seen (+2CS)</label>
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.pocketSized" {{#if p.system.hardware.modifiers.pocketSized}}checked{{/if}} /> Pocket-sized (+1CS)</label>
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.portable" {{#if p.system.hardware.modifiers.portable}}checked{{/if}} /> Portable (+1CS)</label>
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.multiArea" {{#if p.system.hardware.modifiers.multiArea}}checked{{/if}} /> Occupies more than one area (+1CS)</label>
        {{#if (eq p.system.hardware.itemClass "weapon")}}
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.meleeTouch" {{#if p.system.hardware.modifiers.meleeTouch}}checked{{/if}} /> Damage on touch only — melee (-1CS)</label>
        {{/if}}
        {{#if (eq p.system.hardware.itemClass "vehicle")}}
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.noProtection" {{#if p.system.hardware.modifiers.noProtection}}checked{{/if}} /> Offers no Protection (-1CS)</label>
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.gev" {{#if p.system.hardware.modifiers.gev}}checked{{/if}} /> GEV (+1CS)</label>
        {{/if}}
        {{#if (eq p.system.hardware.itemClass "robot")}}
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.humanoid" {{#if p.system.hardware.modifiers.humanoid}}checked{{/if}} /> Humanoid form (-1CS)</label>
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="modifiers.imitatesIndividual" {{#if p.system.hardware.modifiers.imitatesIndividual}}checked{{/if}} /> Imitates a specific individual (+1CS)</label>
        {{/if}}
        <span class="hw-inline-field">
          <label>Custom CS</label>
          <input type="number" step="1" class="hw-field hw-num" data-hw-path="customCS" value="{{p.system.hardware.customCS}}" />
        </span>
        <span class="hw-inline-field">
          <label>Special requirements</label>
          <input type="number" min="0" step="1" class="hw-field hw-num" data-hw-path="specialReqCount" value="{{p.system.hardware.specialReqCount}}" title="RM+ cost may have one; MN+ always has at least one. -1CS each on the success roll (max -3CS). Set by the Judge." />
        </span>
      </div>
      {{/if}}

      <div class="hw-derivation">
        {{#each p.hw.steps}}<div class="hw-step">{{this}}</div>{{/each}}
      </div>

      <div class="hw-time">
        <label class="hw-mods-title">Build time</label>
        <span class="hw-inline-field">
          <label>Assistant</label>
          <select class="hw-field" data-hw-path="time.assistant">
            <option value="none"      {{#if (eq p.system.hardware.time.assistant "none")}}selected{{/if}}>None</option>
            <option value="aid"       {{#if (eq p.system.hardware.time.assistant "aid")}}selected{{/if}}>Lab assistant (time ÷2)</option>
            <option value="brilliant" {{#if (eq p.system.hardware.time.assistant "brilliant")}}selected{{/if}}>Assistant, Reason within one rank (time ÷4, +1CS success)</option>
          </select>
        </span>
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="time.roundTheClock" {{#if p.system.hardware.time.roundTheClock}}checked{{/if}} /> Working straight through (time ÷2, -1CS on success roll)</label>
        <span class="hw-time-readout">{{p.hw.adjDays}} days ({{p.hw.days}} base) · Resource FEAT vs {{p.hw.cost}} · kit-bash: {{p.hw.kitRounds}} rounds, {{p.hw.kitKarma}} Karma</span>
      </div>

      <div class="hw-success-mods">
        <label class="hw-mods-title">Success FEAT modifiers</label>
        <span class="hw-inline-field">
          <label>Applicable talents</label>
          <input type="number" min="0" max="3" step="1" class="hw-field hw-num" data-hw-path="successFeat.talentsCS" value="{{p.system.hardware.successFeat.talentsCS}}" title="+1CS each — e.g. Electronics for a robot, Piloting for a plane. Max +3CS." />
        </span>
        <label class="hw-mod"><input type="checkbox" class="hw-field" data-hw-path="successFeat.rebuild" {{#if p.system.hardware.successFeat.rebuild}}checked{{/if}} /> Rebuilding from failed experiment / kit-bash salvage (+1CS)</label>
        <span class="hw-success-readout">Success roll: Reason column <b>{{p.hw.shiftedReason}}</b> ({{#if p.hw.successCSPos}}+{{/if}}{{p.hw.successCS}}CS)</span>
        {{#if p.hw.degrade}}
        <span class="hw-degrade-warn"><i class="fas fa-triangle-exclamation"></i> Effective cost exceeds shifted Reason — result reads one color worse.</span>
        {{/if}}
      </div>
    </details>
  </div>
  {{/each}}
  {{else}}
  <div class="hw-empty">No inventions yet. Use <b>+ new invention</b> to start one — completed devices remain normal equipment items and appear on the Equipment tab.</div>
  {{/if}}
</div>
