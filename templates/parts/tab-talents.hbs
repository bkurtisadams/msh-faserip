        <div class="tab" data-tab="talents">
          <div class="tab-list-header">
            <span>Talents</span>
            <div class="th-actions">
              <a class="th-action-link add-talent" title="Add Talent">+ add</a>
              <a class="th-action-link browse-compendium" data-type="talents" title="Browse Talents Compendium">browse</a>
            </div>
          </div>

          <div class="talents-list">
            {{#each talents as |talent|}}
            <div class="talent-item item" data-item-id="{{talent._id}}" draggable="true">
              <a class="item-control talent-roll" title="Roll" data-item-id="{{talent._id}}"><i
                  class="fas fa-dice-d20"></i></a>
                  <img src="{{talent.img}}" class="talent-icon talent-info" width="24" height="24"
                  data-item-id="{{talent._id}}"
                  title="Click for info. Shift+drag to reorder." />
              <span class="talent-name-text">{{talent.name}}</span>
              <div class="item-controls">
                <a class="item-control item-edit" title="Edit" data-item-id="{{talent._id}}"><i
                    class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="Delete" data-item-id="{{talent._id}}"><i
                    class="fas fa-trash"></i></a>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
