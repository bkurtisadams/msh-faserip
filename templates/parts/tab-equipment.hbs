{{!-- tab-equipment.hbs — v2.2.9: Gear group is now the catch-all bucket for any category not in weapon/other/armor/power-item, so dropped compendium items with empty/unknown categories render instead of vanishing. --}}
        <div class="tab" data-tab="equipment">
          <div class="tab-list-header labeled">
            <span class="th-label">Equipment</span>
            <div class="th-actions">
              <a class="th-action-link add-equipment" title="Add Equipment">+ add</a>
              <a class="th-action-link browse-compendium" data-type="equipment" title="Browse Equipment Compendium">browse</a>
            </div>
          </div>

          {{! ── WEAPONS ── }}
          {{#if equipmentCounts.weapon}}
          <div class="equip-group" data-group="weapon">
            <table class="equipment-table">
              <thead>
                <tr>
                  <th class="name-col">Weapon</th>
                  <th class="material-col">Mat.</th>
                  <th class="broken-col" title="Broken status"><i class="fas fa-heart-crack"></i></th>
                  <th class="damage-col">Dmg</th>
                  <th class="type-col">Type</th>
                  <th class="range-col">Range</th>
                  <th class="rate-col">Rate</th>
                  <th class="shots-col">Shots</th>
                  <th class="actions-col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {{#each equipment as |item|}}
                {{#if (eq item.system.category "weapon")}}
                <tr class="equipment-row item" data-item-id="{{item._id}}" title="{{item.system.description}}">
                  <td class="equipment-name">
                    <a class="item-control equipment-roll" data-item-id="{{item._id}}" title="Roll"><i class="fas fa-dice-d20"></i></a>
                    <img src="{{item.img}}" class="equipment-icon equipment-info" width="24" height="24" title="Click for info. Shift+drag to reorder." />
                    <span class="equipment-name-text">{{item.name}}</span>
                  </td>
                  <td class="equipment-material">{{item.system.materialStrength}}</td>
                  <td class="equipment-broken">
                    {{#if item.system.broken}}<a class="equipment-repair" data-item-id="{{item._id}}" title="Broken — click to repair" style="color:#c62828;"><i class="fas fa-xmark"></i></a>{{/if}}
                  </td>
                  <td class="equipment-damage">{{item.system.damage}}</td>
                  <td class="equipment-type equipment-type-badge" data-dtype="{{item.system.damageType}}">{{item.system.damageType}}</td>
                  <td class="equipment-range">{{item.system.range}}</td>
                  <td class="equipment-rate">{{item.system.rate}}</td>
                  <td class="equipment-shots">
                    <div class="shots-control">
                      <span>{{item.system.shotsRemaining}}/{{item.system.shots}}</span>
                      {{#if (lt item.system.shotsRemaining item.system.shots)}}
                      <a class="reload-weapon" title="Reload" data-item-id="{{item._id}}"><i class="fas fa-sync-alt"></i></a>
                      {{/if}}
                    </div>
                  </td>
                  <td class="equipment-controls">
                    <a class="item-control item-edit" title="Edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="Delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a>
                  </td>
                </tr>
                {{/if}}
                {{/each}}
              </tbody>
            </table>
          </div>
          {{/if}}

          {{! ── ARMOR ── }}
          {{#if equipmentCounts.other}}
          <div class="equip-group" data-group="other">
            <table class="equipment-table">
              <thead>
                <tr>
                  <th class="name-col">Other Weapon</th>
                  <th class="type-col">Type</th>
                  <th class="damage-col">Dmg</th>
                  <th class="range-col">Range</th>
                  <th class="shots-col">Count</th>
                  <th class="actions-col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {{#each equipment as |item|}}
                {{#if (eq item.system.category "other")}}
                <tr class="equipment-row item" data-item-id="{{item._id}}" title="{{item.system.description}}">
                  <td class="equipment-name">
                    <a class="item-control equipment-roll" data-item-id="{{item._id}}" title="Use"><i class="fas fa-dice-d20"></i></a>
                    <img src="{{item.img}}" class="equipment-icon equipment-info" width="24" height="24" title="Click for info." />
                    <span class="equipment-name-text">{{item.name}}</span>
                  </td>
                  <td class="equipment-type">{{item.system.grenadeType}}{{item.system.missileType}}</td>
                  <td class="equipment-damage">{{item.system.grenadeDamage}}{{item.system.missileDamage}}</td>
                  <td class="equipment-range">{{item.system.range}}</td>
                  <td class="equipment-shots">
                    <input type="number" class="item-field" name="system.shotsRemaining" value="{{item.system.shotsRemaining}}" data-item-id="{{item._id}}" min="0" style="width:40px;text-align:center;" title="Current count (edit to adjust). Use Edit dialog Quantity to restock.">
                    <span style="font-size:.75em;color:#888;">/{{item.system.shots}}</span>
                  </td>
                  <td class="equipment-controls">
                    <a class="item-control item-edit" title="Edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="Delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a>
                  </td>
                </tr>
                {{/if}}
                {{/each}}
              </tbody>
            </table>
          </div>
          {{/if}}

          {{#if equipmentCounts.armor}}
          <div class="equip-group" data-group="armor">
            <table class="equipment-table">
              <thead>
                <tr>
                  <th class="name-col">Armor</th>
                  <th class="material-col">Mat.</th>
                  <th class="broken-col" title="Broken status"><i class="fas fa-heart-crack"></i></th>
                  <th class="damage-col">Protection</th>
                  <th class="type-col">Coverage</th>
                  <th class="range-col"></th>
                  <th class="rate-col"></th>
                  <th class="shots-col"></th>
                  <th class="actions-col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {{#each equipment as |item|}}
                {{#if (eq item.system.category "armor")}}
                <tr class="equipment-row item" data-item-id="{{item._id}}" title="{{item.system.description}}">
                  <td class="equipment-name">
                    <img src="{{item.img}}" class="equipment-icon equipment-info" width="24" height="24" title="Click for info." />
                    <span class="equipment-name-text">{{item.name}}</span>
                  </td>
                  <td class="equipment-material">{{item.system.materialStrength}}</td>
                  <td class="equipment-broken">
                    {{#if item.system.broken}}<a class="equipment-repair" data-item-id="{{item._id}}" title="Broken — click to repair" style="color:#c62828;"><i class="fas fa-xmark"></i></a>{{/if}}
                  </td>
                  <td class="equipment-damage">{{item.system.protection}}</td>
                  <td class="equipment-type">{{item.system.coverage}}</td>
                  <td></td><td></td><td></td>
                  <td class="equipment-controls">
                    <a class="item-control item-edit" title="Edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="Delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a>
                  </td>
                </tr>
                {{/if}}
                {{/each}}
              </tbody>
            </table>
          </div>
          {{/if}}

          {{! ── POWER ITEMS ── }}
          {{#if equipmentCounts.powerItem}}
          <div class="equip-group" data-group="power-item">
            <table class="equipment-table">
              <thead>
                <tr>
                  <th class="name-col">Power Item</th>
                  <th class="material-col">Mat.</th>
                  <th class="broken-col" title="Broken status"><i class="fas fa-heart-crack"></i></th>
                  <th class="damage-col">Rank</th>
                  <th class="type-col">Power Type</th>
                  <th class="range-col">Range</th>
                  <th class="rate-col"></th>
                  <th class="shots-col"></th>
                  <th class="actions-col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {{#each equipment as |item|}}
                {{#if (eq item.system.category "power-item")}}
                <tr class="equipment-row item" data-item-id="{{item._id}}" title="{{item.system.description}}">
                  <td class="equipment-name">
                    <a class="item-control equipment-roll" data-item-id="{{item._id}}" title="Roll"><i class="fas fa-dice-d20"></i></a>
                    <img src="{{item.img}}" class="equipment-icon equipment-info" width="24" height="24" title="Click for info." />
                    <span class="equipment-name-text">{{item.name}}</span>
                  </td>
                  <td class="equipment-material">{{item.system.materialStrength}}</td>
                  <td class="equipment-broken">
                    {{#if item.system.broken}}<a class="equipment-repair" data-item-id="{{item._id}}" title="Broken — click to repair" style="color:#c62828;"><i class="fas fa-xmark"></i></a>{{/if}}
                  </td>
                  <td class="equipment-damage">{{item.system.powerRank}}</td>
                  <td class="equipment-type">{{item.system.powerType}}</td>
                  <td class="equipment-range">{{item.system.powerRange}}</td>
                  <td></td><td></td>
                  <td class="equipment-controls">
                    <a class="item-control item-edit" title="Edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="Delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a>
                  </td>
                </tr>
                {{/if}}
                {{/each}}
              </tbody>
            </table>
          </div>
          {{/if}}

          {{! ── GEAR & CUSTOM ── }}
          {{#if equipmentCounts.gear}}
          <div class="equip-group" data-group="gear">
            <table class="equipment-table">
              <thead>
                <tr>
                  <th class="name-col">Gear</th>
                  <th class="material-col">Mat.</th>
                  <th class="broken-col" title="Broken status"><i class="fas fa-heart-crack"></i></th>
                  <th class="damage-col"></th>
                  <th class="type-col">Notes</th>
                  <th class="range-col"></th>
                  <th class="rate-col"></th>
                  <th class="shots-col"></th>
                  <th class="actions-col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {{#each equipment as |item|}}
                {{#unless (includes (array "weapon" "other" "armor" "power-item") item.system.category)}}
                <tr class="equipment-row item" data-item-id="{{item._id}}" title="{{item.system.description}}">
                  <td class="equipment-name">
                    <a class="item-control equipment-roll" data-item-id="{{item._id}}" title="Actions"><i class="fas fa-dice-d20"></i></a>
                    <img src="{{item.img}}" class="equipment-icon equipment-info" width="24" height="24" title="Click for info." />
                    <span class="equipment-name-text">{{item.name}}</span>
                  </td>
                  <td class="equipment-material">{{item.system.materialStrength}}</td>
                  <td class="equipment-broken">
                    {{#if item.system.broken}}<a class="equipment-repair" data-item-id="{{item._id}}" title="Broken — click to repair" style="color:#c62828;"><i class="fas fa-xmark"></i></a>{{/if}}
                  </td>
                  <td>{{#if item.system.intensityRank}}<span class="intensity-badge" title="Intensity">{{item.system.intensityRank}}</span>{{/if}}</td>
                  <td class="equipment-type">{{item.system.description}}</td>
                  <td></td><td></td><td></td>
                  <td class="equipment-controls">
                    <a class="item-control item-edit" title="Edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="Delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a>
                  </td>
                </tr>
                {{/unless}}
                {{/each}}
              </tbody>
            </table>
          </div>
          {{/if}}

          {{#unless equipment.length}}
          <p class="no-equipment">No equipment added yet.</p>
          {{/unless}}
        </div>
