      <div class="tab" data-tab="stunts">
        <div class="tab-list-header">
          <div class="th-actions">
            <a class="th-action-link add-stunt-general" title="Add Power Stunt">+ add</a>
          </div>
        </div>
        <table class="stunts-table">
          <thead>
            <tr>
              <th class="roll-column">Roll</th>
              <th>Stunt Name</th>
              <th>Parent Power</th>
              <th>Rank</th>
              <th>Value</th>
              <th>Difficulty</th>
              <th>Times Used</th>
              <th class="th-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each system.stunts as |stunt stuntIndex|}}
            <tr class="stunt-row" data-stunt-index="{{stuntIndex}}">
              <!-- Roll Button Column -->
              <td class="stunt-roll-cell">
                <a class="stunt-roll-link roll-stunt-tab" 
                  data-stunt-index="{{stuntIndex}}"
                  title="Roll stunt">
                  <i class="fas fa-dice-d20"></i>
                </a>
              </td>
              
              <!-- Clickable Stunt Name -->
              <td class="stunt-name">
                <a class="stunt-name-link show-stunt-description" 
                  data-stunt-index="{{stuntIndex}}"
                  title="Show description in chat">
                  {{stunt.name}}
                </a>
              </td>
              
              <!-- Parent Power -->
              <td class="stunt-parent">
                {{#if stunt.parentPower}}
                  <span style="font-style: italic; color: #666;">{{stunt.parentPower}}</span>
                {{else}}
                  <span style="color: #999;">—</span>
                {{/if}}
              </td>
              
              <!-- Rank -->
              <td class="stunt-rank">{{stunt.rank}}</td>
              
              <!-- Value -->
              <td class="stunt-value">{{stunt.value}}</td>
              
              <!-- Difficulty -->
              <td class="stunt-difficulty">
                <span class="difficulty-badge 
                  {{#if (lt stunt.timesUsed 1)}}difficulty-red
                  {{else if (lt stunt.timesUsed 4)}}difficulty-yellow
                  {{else if (lt stunt.timesUsed 10)}}difficulty-green
                  {{else}}difficulty-mastered{{/if}}">
                  {{#if (lt stunt.timesUsed 1)}}Red FEAT
                  {{else if (lt stunt.timesUsed 4)}}Yellow FEAT
                  {{else if (lt stunt.timesUsed 10)}}Green FEAT
                  {{else}}Mastered{{/if}}
                </span>
              </td>
              
              <!-- Times Used -->
              <td class="stunt-uses">{{stunt.timesUsed}}</td>
              
              <!-- Actions (Edit/Delete) -->
              <td class="stunt-controls">
                <a class="item-control edit-stunt-tab" title="Edit" 
                  data-stunt-index="{{stuntIndex}}">
                  <i class="fas fa-edit"></i>
                </a>
                <a class="item-control delete-stunt-tab" title="Delete" 
                  data-stunt-index="{{stuntIndex}}">
                  <i class="fas fa-trash"></i>
                </a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>

        {{#unless system.stunts.length}}
        <p class="no-stunts">No power stunts created yet.</p>
        {{/unless}}
      </div>
