      <div class="tab" data-tab="stunts">
        <table class="stunts-table">
          <thead>
            <tr>
              <th class="roll-column">Roll</th>
              <th>Stunt Name<span class="th-inline-actions"><a class="th-action-link add-stunt-general" title="Add Power Stunt">+ add</a></span></th>
              <th>Parent Power</th>
              <th>Rank</th>
              <th>Value</th>
              <th>Difficulty</th>
              <th title="Successful uses; ten masters the stunt">Successes</th>
              <th class="th-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each stuntRows as |row|}}
            <tr class="stunt-row" data-stunt-index="{{row.index}}">
              <td class="stunt-roll-cell">
                <a class="stunt-roll-link roll-stunt-tab" data-stunt-index="{{row.index}}" title="Roll stunt">
                  <i class="fas fa-dice-d20"></i>
                </a>
              </td>

              <td class="stunt-name">
                <a class="stunt-name-link show-stunt-description" data-stunt-index="{{row.index}}" title="Show description in chat">{{row.name}}</a>
              </td>

              <td class="stunt-parent">
                {{#if row.parentName}}
                  <span style="font-style: italic; color: #666;">{{row.parentName}}</span>{{#if row.parentMissing}} <span style="color: #c62828;" title="The linked power is no longer on this character; the stored rank is used">(missing)</span>{{/if}}
                {{else}}
                  <span style="color: #999;">—</span>
                {{/if}}
              </td>

              <td class="stunt-rank">
                {{row.rank}}
                {{#if row.shiftLabel}}<div style="font-size: .85em; color: #666;" title="Rank the stunt's effect uses">effect {{row.shiftLabel}}</div>{{/if}}
              </td>

              <td class="stunt-value">{{row.value}}</td>

              <td class="stunt-difficulty">
                <span class="difficulty-badge difficulty-{{row.statusKey}}">{{row.statusLabel}}</span>
                {{#unless row.mastered}}<div style="font-size: .85em; color: #666;">{{row.costLabel}}</div>{{/unless}}
              </td>

              <td class="stunt-uses" title="{{#if row.mastered}}Mastered{{else}}{{row.toMastery}} more to master{{/if}}">{{row.successes}}</td>

              <td class="stunt-controls">
                <a class="item-control edit-stunt-tab" title="Edit" data-stunt-index="{{row.index}}">
                  <i class="fas fa-edit"></i>
                </a>
                <a class="item-control delete-stunt-tab" title="Delete" data-stunt-index="{{row.index}}">
                  <i class="fas fa-trash"></i>
                </a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>

        {{#unless stuntRows.length}}
        <p class="no-stunts">No power stunts created yet.</p>
        {{/unless}}
      </div>
