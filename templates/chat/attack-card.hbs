<div class="faserip-attack-card faserip-attack-card--{{formClass}}" style="background:#f5f5f0;border:1px solid #c0c0c0;border-radius:3px;margin-bottom:5px;overflow:hidden;color:#333;">

  <div style="padding:7px 12px;border-bottom:1px solid #d8d8d0;display:flex;justify-content:space-between;align-items:center;gap:8px;">
    <span style="min-width:0;"><strong style="color:#8b0000;font-size:15px;letter-spacing:.3px;">{{actionLabel}}</strong>{{#if weaponName}} <span style="color:#888;font-size:13px;">({{weaponName}})</span>{{/if}}</span>
    {{{indicatorHtml}}}
  </div>

  {{#if hasTarget}}<div style="padding:6px 12px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e2e2da;font-size:14px;"><span><span style="color:#888;">Target:</span> <strong style="color:#d32f2f;">{{targetName}}</strong></span><span><span style="color:#888;">Range:</span> <strong>{{rangeText}}</strong></span></div>{{/if}}

  {{{badgesHtml}}}

  <div style="text-align:center;font-weight:bold;font-size:16px;letter-spacing:1.5px;padding:8px 10px;background:{{resultBg}};color:{{resultFg}};">{{resultText}}</div>

  <div style="display:flex;background:#fff;text-align:center;border-bottom:1px solid #ddd;">
    <div style="flex:1;padding:8px 4px;border-right:1px solid #ececec;cursor:help;" title="{{rollTooltip}}">
      <div style="font-size:26px;font-weight:bold;color:#222;line-height:1;">{{rollNum}}</div>
      <div style="font-size:11px;letter-spacing:.5px;color:#9a9a9a;margin-top:5px;">ROLL</div>
    </div>
    <div style="flex:1.7;padding:8px 3px;border-right:1px solid #ececec;cursor:help;" title="{{effRankTooltip}}">
      <div style="font-size:16px;font-weight:bold;color:#333;line-height:1.1;padding-top:3px;">{{effRankValue}}</div>
      <div style="font-size:11px;letter-spacing:.5px;color:#9a9a9a;margin-top:6px;">{{abilityLabelUpper}}</div>
    </div>
    <div style="flex:1;padding:8px 4px;{{#if dmgTooltip}}cursor:help;{{/if}}"{{#if dmgTooltip}} title="{{dmgTooltip}}"{{/if}}>
      <div style="font-size:26px;font-weight:bold;color:#c62828;line-height:1;">{{dmgValue}}</div>
      <div style="font-size:11px;letter-spacing:.5px;color:#9a9a9a;margin-top:5px;">DAMAGE</div>
    </div>
  </div>

  {{{notesHtml}}}
  {{{consequenceHtml}}}
  {{{actionsHtml}}}
  {{{manualNoticeHtml}}}
</div>
